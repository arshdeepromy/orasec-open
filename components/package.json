{
  "name": "orasec",
  "version": "1.0.0",
  "license": "BSD-3-Clause",
  "private": true,
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.2",
    "@fontsource/ibm-plex-mono": "^5.2",
    "@scalar/api-reference": "1.75.0",
    "bootstrap-wysiwyg": "^2.0.0",
    "chart.js": "^4.4",
    "chartjs-adapter-moment": "^1.0",
    "chosen-bootstrap": "https://github.com/dbtek/chosen-bootstrap",
    "chosen-js": "^1.8.7",
    "clipboard": "^2.0.11",
    "datatables.net": "^2.3.8",
    "datatables.net-buttons": "^3.2.6",
    "datatables.net-colreorder": "^2.1.2",
    "easymde": "^2.21.0",
    "flatpickr": "^4.6",
    "fullcalendar": "^3.10.2",
    "jquery": "^3.7.1",
    "jquery-ui": "1.14.2",
    "jquery.hotkeys": "jeresig/jquery.hotkeys#master",
    "jszip": "^3.10.2",
    "moment": "^2.31.0",
    "pdfmake": "^0.3.12"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3",
    "@tailwindcss/forms": "^0.5",
    "tailwindcss": "^4.3"
  },
  "resolutions": {
    "undici": "^7.30.1"
  },
  "scripts": {
    "copy:fonts": "mkdir -p ../orasec/static/orasec/css/files && rm -f ../orasec/static/orasec/css/files/*.woff2 && cp node_modules/@fontsource/ibm-plex-sans/files/ibm-plex-sans-*-[4567]00-normal.woff2 node_modules/@fontsource/ibm-plex-mono/files/ibm-plex-mono-*-[45]00-normal.woff2 ../orasec/static/orasec/css/files/",
    "build:css": "npm run copy:fonts && npx @tailwindcss/cli -i tailwind.css -o ../orasec/static/orasec/css/tailwind-out.css --minify",
    "watch:css": "npm run copy:fonts && npx @tailwindcss/cli -i tailwind.css -o ../orasec/static/orasec/css/tailwind-out.css --watch"
  },
  "engines": {
    "yarn": ">= 1.0.0"
  }
}
