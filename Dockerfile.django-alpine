
# code: language=Dockerfile

# The code for the build image should be identical with the code in
# Dockerfile.nginx to use the caching mechanism of Docker.

# Ref: https://devguide.python.org/#branchstatus
FROM python:3.14.8-alpine3.23@sha256:e7cff362a12454395f8dc99607c21a602ea880cdce03538877b90c2ba932b16f AS base
FROM base AS build
WORKDIR /app
RUN \
  apk update && \
  apk upgrade --no-cache && \
  apk add --no-cache \
    gcc \
    build-base \
    bind-tools \
    postgresql18-client \
    xmlsec \
    git \
    util-linux \
    curl-dev \
    openssl \
    libffi-dev \
    python3-dev \
    libpq-dev \
    && \
    rm -rf /var/cache/apk/* && \
  true
COPY requirements.txt ./
# CPUCOUNT=1 is needed, otherwise the wheel for uwsgi won't always be build succesfully
# https://github.com/unbit/uwsgi/issues/1318#issuecomment-542238096
RUN export PYCURL_SSL_LIBRARY=openssl && \
    CPUCOUNT=1 pip3 wheel --wheel-dir=/tmp/wheels -r ./requirements.txt

FROM base AS release
WORKDIR /app
ARG uid=1001
ARG gid=1337
ARG appuser=orasec
ENV appuser=${appuser}
RUN \
  apk update && \
  apk upgrade --no-cache && \
  apk add --no-cache \
    openjpeg \
    jpeg \
    bind-tools \
    xmlsec \
    git \
    util-linux \
    postgresql18-client \
    curl-dev \
    openssl \
    # needed for integration-tests
    bash \
    && \
    rm -rf /var/cache/apk/* && \
  true
# Upgrade the system trust store and shared libraries in their own layer. Release
# builds reuse the layer above from the build cache, so an OS update to these
# packages (ca-certificates here after the eMudhra key compromise, 2026-10-20)
# would otherwise never reach the image.
# Bump OS_REFRESH to force this layer to rebuild for the next package update.
ARG OS_REFRESH=2026-10-28
RUN echo "OS package refresh ${OS_REFRESH}" && apk upgrade --no-cache ca-certificates-bundle ca-certificates brotli-libs brotli brotli-dev
RUN \
  --mount=from=build,src=/tmp/wheels,target=/tmp/wheels \
  --mount=from=build,src=/app/requirements.txt,target=/app/requirements.txt \
  pip3 install \
	--no-cache-dir \
	--no-index \
  --find-links=/tmp/wheels \
  -r ./requirements.txt
# Fail the build if either trust store still carries the root distrusted after the
# eMudhra key compromise (2026-10-20), so a cached or stale layer can't ship it.
RUN python3 -c "import ssl, sys, certifi; bad = [f for f in ('/etc/ssl/certs/ca-certificates.crt', certifi.where()) if (lambda ctx: ctx.load_verify_locations(cafile=f) or any(dict(x[0] for x in c['subject']).get('commonName') == 'emSign ECC Root CA - G3' for c in ctx.get_ca_certs()))(ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT))]; sys.exit('distrusted root emSign ECC Root CA - G3 still in: ' + ', '.join(bad) if bad else 0)"

COPY \
  docker/entrypoint-celery-beat.sh \
  docker/entrypoint-celery-worker.sh \
  docker/entrypoint-initializer.sh \
  docker/entrypoint-uwsgi.sh \
  docker/wait-for-it.sh \
  docker/secret-file-loader.sh \
  docker/reach_database.sh \
  docker/reach_broker.sh \
  docker/certs/* \
  /
COPY manage.py ./
COPY orasec/ ./orasec/

# OraSec: local GeoIP databases for the attack map (DB-IP Lite, CC BY 4.0, https://db-ip.com).
# Looked up locally so attacker IPs are never sent to third-party services.
RUN mkdir -p /app/geoip && cd /app/geoip && M=$(date +%Y-%m) && P=$(date -d "$(date +%Y-%m-01) -1 month" +%Y-%m 2>/dev/null || date +%Y-%m) && \
    for db in country asn; do \
      (wget -q -O dbip-$db-lite.mmdb.gz https://download.db-ip.com/free/dbip-$db-lite-$M.mmdb.gz || \
       wget -q -O dbip-$db-lite.mmdb.gz https://download.db-ip.com/free/dbip-$db-lite-$P.mmdb.gz) && gunzip -f dbip-$db-lite.mmdb.gz || true; \
    done; ls -la /app/geoip

# Add extra fixtures to docker image which are loaded by the initializer
COPY docker/extra_fixtures/* /app/orasec/fixtures/

RUN \
  # Remove placeholder copied from docker/certs
  rm -f /readme.txt && \
  # Remove placeholder copied from docker/extra_fixtures
  rm -f orasec/fixtures/readme.txt && \
  mkdir -p orasec/migrations && \
  chmod g=u orasec/migrations && \
  true

# Compile translation catalogs (.mo) into the image (the .mo files are gitignored
# and generated at build). msgfmt is run directly so no Django settings/env are
# needed; gettext is only required at build time, so install and remove it here.
# BusyBox find has no -execdir, so the destination is derived with shell
# parameter expansion instead of relying on -execdir's working-directory change.
RUN \
  apk add --no-cache --virtual .build-i18n gettext && \
  find orasec/locale -name 'django.po' -exec sh -c 'msgfmt "$1" -o "${1%.po}.mo"' _ {} \; && \
  apk del .build-i18n
USER root
RUN \
    addgroup --gid ${gid} ${appuser} && \
    adduser --system --no-create-home --disabled-password --gecos '' \
        --uid ${uid} --ingroup ${appuser} ${appuser} && \
    chown -R root:root /app && \
    chmod -R u+rwX,go+rX,go-w /app && \
    # Allow for bind mounting local_settings.py and other setting overrides
    chown -R root:${appuser} /app/orasec/settings && \
    chmod -R 775 /app/orasec/settings && \
    mkdir /var/run/${appuser} && \
    chown ${appuser} /var/run/${appuser} && \
    chmod g=u /var/run/${appuser} && \
    chmod 775 /*.sh && \
    mkdir -p media/threat && chown -R ${uid} media && \
    # To avoid warning: (staticfiles.W004) The directory '/app/components/node_modules' in the STATICFILES_DIRS setting does not exist.
    mkdir -p components/node_modules && \
    chown ${appuser} components/node_modules
USER ${uid}
ENV \
  # Only variables that are not defined in settings.dist.py
  ORASEC_ADMIN_USER=admin \
  ORASEC_ADMIN_MAIL=admin@orasec.local \
  ORASEC_ADMIN_PASSWORD='' \
  ORASEC_ADMIN_FIRST_NAME=Admin \
  ORASEC_ADMIN_LAST_NAME=User \
  ORASEC_CELERY_LOG_LEVEL="INFO" \
  ORASEC_CELERY_WORKER_POOL_TYPE="solo" \
  # Enable prefork and options below to ramp-up celeryworker performance. Presets should work fine for a machine with 8GB of RAM, while still leaving room.
  # See https://docs.celeryproject.org/en/stable/userguide/workers.html#id12 for more details
  # ORASEC_CELERY_WORKER_POOL_TYPE="prefork" \
  # ORASEC_CELERY_WORKER_AUTOSCALE_MIN="2" \
  # ORASEC_CELERY_WORKER_AUTOSCALE_MAX="8" \
  # ORASEC_CELERY_WORKER_CONCURRENCY="8" \
  # ORASEC_CELERY_WORKER_PREFETCH_MULTIPLIER="128" \
  ORASEC_INITIALIZE=true \
  ORASEC_UWSGI_MODE="socket" \
  ORASEC_UWSGI_ENDPOINT="0.0.0.0:3031" \
  ORASEC_UWSGI_NUM_OF_PROCESSES="4" \
  ORASEC_UWSGI_NUM_OF_THREADS="4"
ENTRYPOINT ["/entrypoint-uwsgi.sh"]

FROM release AS development
USER root
COPY \
  requirements-dev.txt \
  docker/unit-tests.sh \
  ./
COPY \
  docker/entrypoint-celery-worker-dev.sh \
  docker/entrypoint-uwsgi-dev.sh \
  docker/entrypoint-unit-tests.sh \
  docker/entrypoint-unit-tests-devDocker.sh \
  /
RUN pip3 install --no-cache-dir -r requirements-dev.txt && \
    chmod 775 /*.sh
USER ${uid}

FROM development AS django-unittests
COPY unittests/ ./unittests/
COPY tests/ ./tests/
