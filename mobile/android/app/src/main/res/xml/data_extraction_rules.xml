<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+): cloud backup and device-to-device transfer. Same
     exclusions as backup_rules.xml (see there). -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="sharedpref" path="OraSecureStore.xml" />
    <exclude domain="sharedpref" path="CapacitorStorage.xml" />
    <exclude domain="sharedpref" path="NativeBiometricSharedPreferences.xml" />
    <exclude domain="root" path="app_webview/" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="sharedpref" path="OraSecureStore.xml" />
    <exclude domain="sharedpref" path="CapacitorStorage.xml" />
    <exclude domain="sharedpref" path="NativeBiometricSharedPreferences.xml" />
    <exclude domain="root" path="app_webview/" />
  </device-transfer>
</data-extraction-rules>
