# Settings for a store build (npm run ios:release, android:release, android:bundle).
# Copy to .env.store and fill in what you need. .env.store is not committed.
#
# All are optional. With none set the app asks for the server address on its first screen.

# A server every copy of your build opens on (an organisation's own build of the app).
# VITE_DEFAULT_SERVER_URL=https://orasec.example.com

# Only for a publisher whose earlier builds had a fixed server: devices that are already linked keep working.
# VITE_LEGACY_SERVER_URL=https://orasec.example.com

# Shown in the app.
# VITE_PUBLISHER=Example Ltd
# VITE_PRIVACY_URL=https://example.com/privacy
# Set this once the source is published; without it the app shows no source links.
# VITE_SOURCE_URL=https://github.com/example/orasec
