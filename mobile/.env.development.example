# Settings for development builds (npm run dev, cap:sync, android:build).
# Copy to .env.development.local and change to suit. Not committed.

# Allow plain http, for a test server on your LAN or the Android emulator. Store builds are https only.
VITE_ALLOW_HTTP=1

# Ready-made servers offered under the address field.
VITE_SERVER_PRESETS=[{"label":"Test server","url":"http://10.0.2.2:8180","hint":"Android emulator to this machine"}]
